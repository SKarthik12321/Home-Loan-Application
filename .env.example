# Copy to ".env" for local runs (never commit .env).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/home_loan_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Must be at least 32 characters for HS256 in this project.
JWT_SECRET=ChangeThisToAVeryLongRandomSecretValue123456
JWT_EXPIRATION_MS=86400000

# Optional default annual interest rate (percent) used by EMI strategy
APP_LOAN_DEFAULT_ANNUAL_RATE=8.5

# Docker Compose (MySQL root password — keep in sync with SPRING_DATASOURCE_PASSWORD for local compose)
MYSQL_ROOT_PASSWORD=root
