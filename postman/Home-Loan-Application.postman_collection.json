{
  "info": {
    "name": "Home Loan Application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth / Login (demo)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"demo-pass-123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Loans / List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/v1/loans"
      }
    },
    {
      "name": "Loans / Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicant\": {\n    \"fullName\": \"Test User\",\n    \"email\": \"test.user@example.com\",\n    \"phone\": \"+1 555-0199\",\n    \"annualIncome\": 88000\n  },\n  \"requestedAmount\": 250000,\n  \"tenureMonths\": 240,\n  \"purpose\": \"Purchase\",\n  \"status\": \"SUBMITTED\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/loans"
      }
    }
  ]
}
